[
  {
    "name": "decays",
    "input": {
      "matrix": [
        [
          0.3,
          0.2
        ],
        [
          0.2,
          0.3
        ]
      ]
    },
    "expected": {
      "radius": 0.5,
      "decays": true
    }
  },
  {
    "name": "boundary",
    "input": {
      "matrix": [
        [
          -1,
          0
        ],
        [
          0,
          0.4
        ]
      ]
    },
    "expected": {
      "radius": 1.0,
      "decays": false
    }
  },
  {
    "name": "nonsymmetric input",
    "input": {
      "matrix": [
        [
          0.3,
          0.2
        ],
        [
          0.1,
          0.3
        ]
      ]
    },
    "expected": {
      "status": "invalid"
    }
  },
  {
    "name": "symmetric but growing",
    "input": {
      "matrix": [
        [
          -1.25,
          0
        ],
        [
          0,
          0.25
        ]
      ]
    },
    "expected": {
      "radius": 1.25,
      "decays": false
    }
  }
]
